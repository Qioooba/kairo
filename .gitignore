# ===== 本地 Go SDK（Win7 兼容构建用 Go 1.20.x，不入仓库）=====
/sdk/

# ===== Go 构建产物 / 缓存 =====
# 编译出来的二进制
/Kairo
/Kairo.exe
/Kairo_mac
/Kairo_*
/kairo-test

# Go 缓存
/.gocache/
/.gomodcache/

# ===== 运行时生成 =====
/logs/
/downloads/
/data/
/dist/

# ===== 系统/编辑器垃圾 =====
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ===== debug 临时文件 =====
/debug_run.go
dbg-*.js
kairo-snap.js
verify-commands.js

# ===== 临时文件 =====
*.tmp

# ===== QA / 测试产物（不应入 git）=====
# Playwright 依赖：~16MB，从 package-lock + npm install 还原
/docs/qa/node_modules/
/docs/qa/package-lock.json
/docs/qa/report.json
# QA 截图：~4MB，CI 跑出来会变，跟 commit 绑一起没意义
/docs/qa/screenshots/
/docs/qa/*-shots/
# 一次性深度测试产物（脚本 / 报告 / 一次性 review）
/docs/qa/*-deep-report.json
/docs/qa/*-deep-summary.json
/docs/qa/REVIEW-*-deep.md
/docs/qa/compare_deep_test.js
/docs/qa/websphere_deep_test.js
/docs/qa/debug_search.js
# 配置文件备份
/config.yaml.bak.*
.mavis/plans/
# Playwright E2E（仓库根目录的临时安装，仅供本地调试）
/node_modules/
/package-lock.json

# ===== E2E 测试输出目录（本地跑出来的截图/JSON，不应入 git）=====
/e2e-*-out/
/theme-test-out/
/theme-*-out/
/playwright-*.js
/kairo*
/Kairo_dev

# ===== Windows exe 资源图标（构建产物，不入库）=====
*.syso
/Kairo.jpg
