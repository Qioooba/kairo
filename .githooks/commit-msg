#!/bin/sh
# Git commit-msg hook: 强制要求提交信息标明执行提交的模型及版本

COMMIT_MSG_FILE="$1"

# 1. 过滤 Git 注释行 (#) 及空行
CLEAN_MSG=$(grep -v '^[[:space:]]*#' "$COMMIT_MSG_FILE" | tr -d '\r')

# 2. 如果是自动生成的合并提交 (Merge commit)，允许跳过校验
FIRST_LINE=$(echo "$CLEAN_MSG" | head -n 1)
case "$FIRST_LINE" in
    Merge\ branch*|Merge\ remote-tracking\ branch*|Merge\ pull\ request*)
        exit 0
        ;;
esac

# 3. 检查是否包含 Model: 或 AI-Model: 标签行
MODEL_LINE=$(echo "$CLEAN_MSG" | grep -Ei '^(AI-)?Model:[[:space:]]*[^[:space:]]+')

if [ -z "$MODEL_LINE" ]; then
    echo ""
    echo "================================================================================"
    echo "[ERROR] Git Commit 校验失败：提交信息必须注明模型全称与具体版本！"
    echo "--------------------------------------------------------------------------------"
    echo "原因: 提交信息末尾未找到 'Model: <精确模型版本>' 标识。"
    echo ""
    echo "正确格式示例："
    echo "    feat(workbench): 修复 runQuery 作用域与 DDL 守卫"
    echo ""
    echo "    - 修复 database.js 中 querySource 作用域问题"
    echo ""
    echo "    Model: Gemini 3.8 Flash"
    echo ""
    echo "提示："
    echo "  - AI 提交必须精确到具体版本（如 Gemini 3.8 Flash / Claude 3.7 Sonnet / GPT-4o）"
    echo "  - 人类开发者手动提交可标注: Model: Human"
    echo "  - 紧急情况可使用 'git commit --no-verify' 跳过门禁"
    echo "================================================================================"
    echo ""
    exit 1
fi

# 4. 提取模型名称并去除两端空白
MODEL_VAL=$(echo "$MODEL_LINE" | sed -E 's/^([a-zA-Z-]+)?[Mm]odel:[[:space:]]*//' | tr -d '\r\n')
LOWER_VAL=$(echo "$MODEL_VAL" | tr '[:upper:]' '[:lower:]')

# 5. 人类开发者手动提交特例放行
if [ "$LOWER_VAL" = "human" ]; then
    exit 0
fi

# 6. 拦截模糊、不包含版本的宽泛名称
case "$LOWER_VAL" in
    "ai"|"llm"|"bot"|"assistant"|"gemini"|"claude"|"gpt"|"deepseek"|"qwen"|"openai"|"anthropic"|"google"|"gemini flash"|"gemini pro"|"claude sonnet"|"claude opus"|"claude haiku"|"chatgpt")
        echo ""
        echo "================================================================================"
        echo "[ERROR] Git Commit 校验失败：模型名称过于模糊，未精确到具体版本！"
        echo "--------------------------------------------------------------------------------"
        echo "当前填写: $MODEL_VAL"
        echo "必须指明具体版本号，例如："
        echo "    Model: Gemini 3.8 Flash"
        echo "    Model: Claude 3.7 Sonnet"
        echo "    Model: GPT-4o"
        echo "    Model: DeepSeek-V3"
        echo "如果是人类开发者手动提交，请标注: Model: Human"
        echo "================================================================================"
        echo ""
        exit 1
        ;;
esac

# 7. 拦截泛称前缀 (如 AI-1, LLM 2 等)
case "$LOWER_VAL" in
    ai*|llm*|bot*|assistant*)
        if echo "$LOWER_VAL" | grep -Eq '^(ai|llm|bot|assistant)[^a-z0-9]*[0-9]*$'; then
            echo ""
            echo "================================================================================"
            echo "[ERROR] Git Commit 校验失败：禁止使用泛称 '$MODEL_VAL' 作为模型名称！"
            echo "--------------------------------------------------------------------------------"
            echo "必须指明具体模型全称与版本，例如："
            echo "    Model: Gemini 3.8 Flash"
            echo "    Model: Claude 3.7 Sonnet"
            echo "    Model: GPT-4o"
            echo "================================================================================"
            echo ""
            exit 1
        fi
        ;;
esac

# 8. 强制要求包含精确版本号（必须含有数字版本号，如 3.8 / 4o / V3）
if ! echo "$MODEL_VAL" | grep -Eq '[0-9]'; then
    echo ""
    echo "================================================================================"
    echo "[ERROR] Git Commit 校验失败：AI 模型必须注明精确版本号（需包含数字版本，如 3.8 / 4o / V3）！"
    echo "--------------------------------------------------------------------------------"
    echo "当前填写: $MODEL_VAL"
    echo "必须指明版本号，例如："
    echo "    Model: Gemini 3.8 Flash"
    echo "    Model: Claude 3.7 Sonnet"
    echo "    Model: GPT-4o"
    echo "    Model: DeepSeek-V3"
    echo "如果是人类开发者手动提交，请标注: Model: Human"
    echo "================================================================================"
    echo ""
    exit 1
fi

exit 0
