# =====================================================================
# Kairo 配置文件示例
#
# 重要安全提示：
#   1. 不要把 SSH 密码写在这里；密码由 Web 页面在每次操作时输入。
#   2. log_dirs 是白名单：后端只能访问这里声明的目录。
#   3. patterns 字段是允许的 glob 模式，禁止包含 ' ` $ \ ; 等字符。
#   4. host 必须为 127.0.0.1，本工具只在本地监听。
# =====================================================================
#
# ⚠️ 安全默认值清单（直接复制本文件当 config.yaml 用前请阅读）：
#   - enable_free_file_browser: 默认 true（任意路径下载开）
#   - free_file_roots: 默认 []（fail-closed，拒绝任意远端路径）
#   - allow_custom_download_dir: 默认 true（允许下载到指定目录）
#   - allowed_download_roots: 默认 []（fail-closed，拒绝任意本地目录）
#   - auth.enabled: 默认 false（仅本机 127.0.0.1 访问）
#   - credential_store: 默认 keyring
#   - download_retention_days: 默认 7
# 生产环境至少配置：free_file_roots + allowed_download_roots + auth.enabled=true

app:
  name: Kairo
  host: 127.0.0.1
  port: 18080
  auto_open_browser: true
  download_dir: ./downloads
  log_dir: ./logs
  data_dir: ./data

  # 是否启用 v0.3 文件浏览器（任意路径下载）。
  # 默认 true（不写 / 注释掉都视为开启）。设成 false 会让 /api/files/* 全部返回 403。
  # 关闭场景：把工具箱分发给权限较宽的同事，担心被安全审计卡。
  # enable_free_file_browser: true

  # v0.5-G：是否允许用户在下载请求里指定 target_dir（v0.5 项 18「下载到指定目录」）。
  # 默认 true（不写 / 注释掉都视为允许）。设成 false 会让所有带 target_dir 的请求返回 403。
  # 关闭场景：内网严格管控，担心同事误下到 C:\Windows 等敏感位置。
  # allow_custom_download_dir: true

  # v0.5-G：target_dir 白名单（绝对路径前缀），与 allow_custom_download_dir 配合。
  # 为空 = 不限制；非空 = 只允许以列表中某项为前缀的目录（按目录边界匹配）。
  # 推荐设置示例（Windows）：
  # allowed_download_roots:
  #   - "D:/logs"
  #   - "E:/downloads"
  # Linux/Mac 示例：
  # allowed_download_roots:
  #   - "/tmp"
  #   - "/Users/qi/Downloads"

  # ---- CFG-002: credential_store 凭据存储 ----
  # credential_store: keyring  # 默认。keyring / file / disabled
  #   keyring = 系统钥匙串（macOS Keychain / Windows DPAPI / Linux Secret Service）
  #   file    = AES-256 加密本地文件（data/credentials.json），适合无 keyring 的 headless 服务器
  #   disabled = 不持久化密码，每次手动输入
  # credential_key: ""  # file 模式的 AES-256 密钥（hex 64 字符），留空自动生成存 data/.credkey

  # ---- CFG-003: ssh_compat_profile + SSH 调试字段 ----
  # ssh_compat_profile: auto  # modern / compat / no-ecdh / legacy / auto
  #   modern = 仅用现代算法（OpenSSH 7.4+）
  #   compat = 先现代后降级（默认重试链）
  #   no-ecdh = 跳过 ECDH（部分老 AIX）
  #   legacy  = 仅 DH-SHA1（OpenSSH 6.2p2 等极老系统）
  #   auto    = 走默认重试链（等同 compat）
  # ssh_debug: false  # 打开 SSH 调试日志
  # ssh_traffic_dump: false  # 打印 SSH 流量
  # ssh_log_max_mb: 20  # SSH 日志单文件上限
  # ssh_log_keep: 3  # SSH 日志保留份数

  # ---- CFG-004: external_openers 外部打开器 ----
  # external_openers:  # v0.8 起：自定义"用外部程序打开下载文件"按钮
  #   - name: "notepadpp"
  #     path: "C:/Program Files/Notepad++/notepad++.exe"
  #     icon: "📝"
  #   - name: "vscode"
  #     path: "C:/Users/xxx/AppData/Local/Programs/Microsoft VS Code/Code.exe"
  #     icon: "💡"

  # ---- CFG-005: download_retention 下载保留策略 ----
  # download_retention_days: 7  # 下载文件保留天数，默认 7；0=不按时间清理
  # download_max_count: 1000  # 最大下载记录数，默认 1000；0=不限制数量

  # ---- CFG-006: free_file_roots 远端路径白名单 ----
  # free_file_roots:  # 远端路径白名单前缀（fail-closed，空=拒绝任意路径浏览）
  #   - "/opt/IBM/WebSphere"
  #   - "/var/log"
  #   - "/home/ops/logs"
  # 留空 = 拒绝所有 /api/files/* 请求（默认安全）

# 业务系统 -> 服务器 -> 日志目录
systems:
  - name: 信贷生产
    description: WebSphere 生产集群
    servers:
      - name: prod-node-1
        host: 10.10.10.11
        port: 22
        username: wasadmin
        auth_type: password
        # ssh_profile: legacy  # 单 server 覆盖 SSH compat profile
        # host_key_sha256: "SHA256:base64..."  # 固定 host key 指纹（推荐生产配置）
        #   获取方式: ssh-keyscan -t rsa <host> | ssh-keygen -lf -
        log_dirs:
          - name: server1日志
            path: /opt/IBM/WebSphere/AppServer/profiles/AppSrv01/logs/server1
            patterns:
              - SystemOut*.log
              - SystemErr*.log
              - "*.log"
      - name: prod-node-2
        host: 10.10.10.12
        port: 22
        username: wasadmin
        auth_type: password
        log_dirs:
          - name: server1日志
            path: /opt/IBM/WebSphere/AppServer/profiles/AppSrv01/logs/server1
            patterns:
              - SystemOut*.log
              - SystemErr*.log
              - "*.log"

  - name: 信贷测试
    description: WebSphere 测试环境
    servers:
      - name: test-node-1
        host: 10.20.20.11
        port: 22
        username: wasadmin
        auth_type: password
        log_dirs:
          - name: server1日志
            path: /opt/IBM/WebSphere/AppServer/profiles/AppSrv01/logs/server1
            patterns:
              - SystemOut*.log
              - SystemErr*.log
              - "*.log"
            # encoding: utf-8   # 默认 utf-8；老 WebSphere / Oracle 中文日志建议 gbk
      - name: legacy-node-1
        host: 10.20.20.12
        port: 22
        username: wasadmin
        auth_type: password
        log_dirs:
          - name: 老系统日志
            path: /opt/IBM/WebSphere/AppServer/profiles/AppSrv01/logs/server1
            patterns:
              - SystemOut*.log
              - SystemErr*.log
            encoding: gbk
            # list_mode: posix_ls  # gnu_find / posix_ls / auto（AIX 老系统建议 posix_ls）

# 搜索默认参数
search:
  default_latest_files: 3
  max_matches: 200
  default_context_lines: 30
  timeout_seconds: 30
  max_concurrency: 2

# ---- CFG-001: auth 段示例 ----
# auth: （可选）启用 Bearer token 认证 + IP 白名单
# auth:
#   enabled: true
#   tokens:
#     - name: "admin"
#       token: "请生成 32 字节随机 hex"  # openssl rand -hex 32
#       allowed_ips: ["127.0.0.1", "10.0.0.0/8"]  # 可选，CIDR 白名单
#       role: "admin"  # BE-003: admin 可访问敏感管理接口，user 只能普通读写
#     - name: "viewer"
#       token: "另一个随机 hex"
#       role: "user"
